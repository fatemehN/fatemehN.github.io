{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 30000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox"
      ]
    }
  },
  "urls": [
    "http://localhost:8080/index.html",
    "http://localhost:8080/index.html#publications",
    "http://localhost:8080/index.html#gallery",
    {
      "url": "http://localhost:8080/index.html?dark",
      "actions": [
        "click element .theme-toggle",
        "wait for element html[data-theme=\"dark\"] to be added"
      ]
    }
  ]
}
